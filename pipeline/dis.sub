# Filled in by ../prod: PIPELINE, PROD_DIR, FAIRSHIP, DIS_DIR, SAMPLE (SBT or Tr), MUONS_PER_JOB, DIS_PER_MUON, NJOBS
executable = $(PIPELINE)/dis.sh
arguments  = "$(FAIRSHIP) $(DIS_DIR)/$(SAMPLE) $(DIS_DIR)/muonsProduction_wsoft_$(SAMPLE).root $(Process) $(MUONS_PER_JOB) $(DIS_PER_MUON)"

initialdir = $(PROD_DIR)/logs/dis
output     = $(SAMPLE)_$(Cluster)_$(Process).out
error      = $(SAMPLE)_$(Cluster)_$(Process).err
log        = $(SAMPLE)_$(Cluster).log

notify_user  = jasmin.weiss@student.hu-berlin.de
notification = Error

request_CPUs   = 1
request_memory = 4 GB
request_disk   = 5 GB

+JobFlavour = "tomorrow"

on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)
max_retries    = 3
requirements   = (OpSysAndVer =?= "AlmaLinux9") && (Machine =!= LastRemoteHost)
+REQUIRED_OS   = "AlmaLinux9"

# caps how many jobs run at once, so the AFS-hosted FairShip workspace is not hit by hundreds of jobs simultaneously
max_materialize = 200

queue $(NJOBS)
